{
  "name": "vocabulary-sampler",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "cross-env NODE_ENV=production npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "build:corpus": "tsx scripts/build-corpus.ts"
  },
  "devDependencies": {
    "concurrently": "^9.0.1",
    "cross-env": "^7.0.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "wordpos": "^2.1.0"
  }
}
